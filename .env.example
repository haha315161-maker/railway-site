# Railway Variables
# .env dosyasını Railway'a yüklemeyin. Bu değerleri Railway > Variables bölümüne ekleyin.

NODE_ENV=production
SESSION_SECRET=BURAYA_COK_UZUN_RASTGELE_BIR_SECRET_YAZ
ADMIN_EMAIL=admin@example.com
EMAIL_USER=your-gmail@example.com
EMAIL_PASS=your-gmail-app-password

# Railway Volume kullanırsanız: /data/database.db
# DATABASE_PATH=/data/database.db
